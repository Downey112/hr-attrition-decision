	partition factor_tests = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\factor_tests.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {
				        {"factor", type text},
				        {"df", Int64.Type},
				        {"robust_p", type number},
				        {"robust_q_bh", type number},
				        {"p_text", type text},
				        {"q_text", type text},
				        {"p_rank", Int64.Type}
				    }, "en-US")
				in
				    Typed

