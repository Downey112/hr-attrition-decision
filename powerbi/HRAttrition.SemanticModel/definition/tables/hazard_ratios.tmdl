	partition hazard_ratios = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\hazard_ratios.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {
				        {"covariate", type text},
				        {"hazard_ratio", type number},
				        {"hr_lo", type number},
				        {"hr_hi", type number},
				        {"p_robust", type number},
				        {"label", type text},
				        {"significant", type text},
				        {"p_text", type text}
				    }, "en-US")
				in
				    Typed

