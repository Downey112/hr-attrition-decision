table staff
	lineageTag: aed6049e-036d-54d6-b8d6-7ff50f804020

	measure 'Sel k' = SELECTEDVALUE ( 'Loss multiple'[k], 1 )
		formatString: 0.00
		displayFolder: Assumptions
		lineageTag: a90ee22c-f556-5fa5-8095-872a441f22bc

	measure 'Sel c' = SELECTEDVALUE ( 'Intervention cost'[c], 0.10 )
		formatString: 0.00
		displayFolder: Assumptions
		lineageTag: e661b01b-6930-5d37-a88c-bcfbfd74b0df

	measure 'Sel e' = SELECTEDVALUE ( 'Effectiveness'[e], 0.30 )
		formatString: 0%
		displayFolder: Assumptions
		lineageTag: 59813ca7-6f50-5ea7-b9ec-2825a0fcc2fb

	measure 'Risk Threshold' = DIVIDE ( [Sel c], [Sel e] * [Sel k] )
		formatString: 0.0%
		displayFolder: Decision
		lineageTag: 24f2a618-44a4-5b06-9e28-65715ba0dc77

	measure 'Staff Scored' = COUNTROWS ( FILTER ( staff, NOT ISBLANK ( staff[p_leave_12m] ) ) )
		formatString: #,0
		displayFolder: Decision
		lineageTag: 18658ba5-fc6d-560b-9cbb-008bdff7c13d

	measure 'Staff Targeted' =
			VAR t = [Risk Threshold]
			RETURN
			    COUNTROWS ( FILTER ( staff, staff[p_leave_12m] > t ) ) + 0
		formatString: #,0
		displayFolder: Decision
		lineageTag: e3c3d3dc-8a8a-593f-9d7f-4e0466957a5e

	measure 'Share Targeted' = DIVIDE ( [Staff Targeted], [Staff Scored] )
		formatString: 0.0%
		displayFolder: Decision
		lineageTag: 9220ac1a-99f4-5388-b853-1f9aee127a70

	measure 'Mean Risk' = AVERAGE ( staff[p_leave_12m] )
		formatString: 0.0%
		displayFolder: Decision
		lineageTag: 764b4211-d132-54c3-8352-33d4d204b310

	measure 'Expected Saving' =
			VAR k = [Sel k]
			VAR c = [Sel c]
			VAR e = [Sel e]
			VAR t = [Risk Threshold]
			RETURN
			    DIVIDE (
			        SUMX ( FILTER ( staff, staff[p_leave_12m] > t ), staff[p_leave_12m] * e * k - c ),
			        [Staff Scored]
			    ) + 0
		formatString: 0.0%
		displayFolder: Decision
		lineageTag: ce1b3b7d-454c-5792-ad87-cb57854b5c03

	measure 'Median Break-even e' =
			VAR k = [Sel k]
			VAR c = [Sel c]
			RETURN
			    MEDIANX ( FILTER ( staff, staff[p_leave_12m] > 0 ), DIVIDE ( c, staff[p_leave_12m] * k ) )
		formatString: 0%
		displayFolder: Decision
		lineageTag: 23ffcf84-11d6-5cd3-ad78-3cbe1d475b7c

	measure 'Backtest Saving' =
			LOOKUPVALUE (
			    backtest_grid[saving],
			    backtest_grid[k_x100], ROUND ( [Sel k] * 100, 0 ),
			    backtest_grid[c_x100], ROUND ( [Sel c] * 100, 0 ),
			    backtest_grid[e_x100], ROUND ( [Sel e] * 100, 0 )
			)
		formatString: 0.0%
		displayFolder: Decision
		lineageTag: f1479791-3b3e-5116-bb71-dda667ae6726

	measure 'Backtest Value' = IF ( ISBLANK ( [Backtest Saving] ), "n/a", FORMAT ( [Backtest Saving], "+0.0%;-0.0%;0.0%" ) )
		displayFolder: Decision
		lineageTag: 4abd5e6a-66b0-549c-9f85-c5f8256aff05

	measure 'Row Risk If Targeted' =
			VAR p = MAX ( staff[p_leave_12m] )
			RETURN
			    IF ( p > [Risk Threshold], p )
		formatString: 0.0%
		displayFolder: Decision
		lineageTag: 1f405434-08e9-52ef-9c0e-a71cec2b3480

	measure 'Row Net Value' =
			VAR p = MAX ( staff[p_leave_12m] )
			RETURN
			    IF ( p > [Risk Threshold], p * [Sel e] * [Sel k] - [Sel c] )
		formatString: 0.000
		displayFolder: Decision
		lineageTag: dd0dbbe9-bdd8-5b40-b106-3cce7b0f7f4f

	measure 'Row Break-even e' =
			VAR p = MAX ( staff[p_leave_12m] )
			RETURN
			    IF ( p > [Risk Threshold], DIVIDE ( [Sel c], p * [Sel k] ) )
		formatString: 0%
		displayFolder: Decision
		lineageTag: 5dcaac28-7d5e-5f1a-b850-09cf313292d1

	measure 'Bin Color' = IF ( MAX ( staff[risk_bin] ) + 0.0125 > [Risk Threshold], "#1D4ED8", "#CBD5E1" )
		displayFolder: Colors
		lineageTag: 4df6ebb7-da9d-561b-971c-7909b3602fed

	measure 'Label Threshold' = "c ÷ (e × k): intervene above this"
		displayFolder: Labels
		lineageTag: af65c035-97e7-540c-bc3e-908ad7609e81

	measure 'Label Targeted' = FORMAT ( [Share Targeted], "0.0%" ) & " of " & FORMAT ( [Staff Scored], "#,0" ) & " scored staff"
		displayFolder: Labels
		lineageTag: 4e8c9a2b-3bb8-5ab9-a250-77176c2a3b98

	measure 'Label Expected' = "net saving per employee, × salary"
		displayFolder: Labels
		lineageTag: ad9df5bc-f267-5f3f-9452-dcfb17192ff9

	measure 'Label Backtest' =
			VAR lo = LOOKUPVALUE ( backtest_grid[lo95], backtest_grid[k_x100], ROUND ( [Sel k] * 100, 0 ), backtest_grid[c_x100], ROUND ( [Sel c] * 100, 0 ), backtest_grid[e_x100], ROUND ( [Sel e] * 100, 0 ) )
			VAR hi = LOOKUPVALUE ( backtest_grid[hi95], backtest_grid[k_x100], ROUND ( [Sel k] * 100, 0 ), backtest_grid[c_x100], ROUND ( [Sel c] * 100, 0 ), backtest_grid[e_x100], ROUND ( [Sel e] * 100, 0 ) )
			RETURN
			    IF ( ISBLANK ( [Backtest Saving] ), "not a back-tested scenario",
			        "95% CI " & FORMAT ( lo, "0.0%" ) & " to " & FORMAT ( hi, "0.0%" ) )
		displayFolder: Labels
		lineageTag: b68369fd-2855-5e84-84e9-6a5d30e594c7

	measure 'Label Break-even' = "median needed to break even"
		displayFolder: Labels
		lineageTag: c5403c4f-46c8-5ca6-8e90-172760dca6a6

	measure 'Title Histogram' = "12-month leaving risk, current staff · blue = above " & FORMAT ( [Risk Threshold], "0.0%" )
		displayFolder: Titles
		lineageTag: 1dfe7f3c-3528-5419-b04e-1bcc6b933100

	measure 'Title Staff Table' = FORMAT ( [Staff Targeted], "#,0" ) & " staff to target at k = " & FORMAT ( [Sel k], "0.00" ) & ", c = " & FORMAT ( [Sel c], "0.00" ) & ", e = " & FORMAT ( [Sel e], "0%" ) & ", highest risk first"
		displayFolder: Titles
		lineageTag: 1520d230-1591-5c83-8ae1-664adeed8701

