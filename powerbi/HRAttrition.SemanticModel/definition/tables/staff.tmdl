	partition staff = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\staff.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {
				        {"row_id", Int64.Type},
				        {"tenure_months", type number},
				        {"industry", type text},
				        {"profession", type text},
				        {"traffic", type text},
				        {"coach", type text},
				        {"greywage", type text},
				        {"way", type text},
				        {"p_leave_12m", type number},
				        {"risk_bin", type number},
				        {"gender", type text},
				        {"age_band", type text}
				    }, "en-US")
				in
				    Typed
